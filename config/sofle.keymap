#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    hml: hml {
        compatible = "zmk,behavior-hold-tap";
        label = "home_row_mod_left";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-key-positions = <43 44 55 56 31 6 7 18 19 30 31 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 45 46 47 48 49 57 58 59>;
        hold-trigger-on-release;
    };

    hmr: hmr {
        compatible = "zmk,behavior-hold-tap";
        label = "home_row_mod_right";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-key-positions = <43 44 55 56 31 6 7 18 19 30 31 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 45 46 47 48 49 57 58 59>;
        hold-trigger-on-release;
    };

    enc_shift_up: enc_shift_up {
        compatible = "zmk,behavior-mod-morph";
        label = "ENC_SHIFT_UP";
        bindings = <&kp C_VOLUME_UP>, <&kp C_BRIGHTNESS_INC>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    enc_shift_down: enc_shift_down {
        compatible = "zmk,behavior-mod-morph";
        label = "ENC_SHIFT_DOWN";
        bindings = <&kp C_VOLUME_DOWN>, <&kp C_BRIGHTNESS_DEC>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    inc_dec_gresc: inc_dec_gresc {
        compatible = "zmk,behavior-sensor-rotate-var";
        label = "INC_DEC_GRESC";
        #sensor-binding-cells = <2>;
        bindings = <&enc_gui_up>, <&enc_gui_down>;
    };

    enc_ctrl_up: enc_ctrl_up {
        compatible = "zmk,behavior-mod-morph";
        label = "ENC_CTRL_UP";
        bindings = <&enc_shift_up>, <&bt BT_NXT>;

        #binding-cells = <0>;
        mods = <(MOD_LCTL|MOD_RCTL)>;
    };

    enc_ctrl_down: enc_ctrl_down {
        compatible = "zmk,behavior-mod-morph";
        label = "ENC_CTRL_DOWN";
        bindings = <&enc_shift_down>, <&bt BT_PRV>;

        #binding-cells = <0>;
        mods = <(MOD_LCTL|MOD_RCTL)>;
    };

    enc_alt_up: enc_alt_up {
        compatible = "zmk,behavior-mod-morph";
        label = "ENC_ALT_UP";
        bindings = <&enc_ctrl_up>, <&kp LA(TAB)>;

        #binding-cells = <0>;
        mods = <(MOD_LALT|MOD_RALT)>;
    };

    enc_alt_down: enc_alt_down {
        compatible = "zmk,behavior-mod-morph";
        label = "ENC_ALT_DOWN";
        bindings = <&enc_ctrl_down>, <&kp LA(LS(TAB))>;

        #binding-cells = <0>;
        mods = <(MOD_LALT|MOD_RALT)>;
    };

    enc_gui_up: enc_gui_up {
        compatible = "zmk,behavior-mod-morph";
        label = "ENC_GUI_UP";
        bindings = <&enc_alt_up>, <&kp LG(LC(RIGHT))>;

        #binding-cells = <0>;
        mods = <(MOD_RGUI|MOD_LGUI)>;
    };

    enc_gui_down: enc_gui_down {
        compatible = "zmk,behavior-mod-morph";
        label = "ENC_GUI_DOWN";
        bindings = <&enc_alt_down>, <&kp LG(LC(LEFT))>;

        #binding-cells = <0>;
        mods = <(MOD_RGUI|MOD_LGUI)>;
    };

    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        colemak-no-hrm {
            bindings = <
&kp GRAVE   &kp N1  &kp N2      &kp N3        &kp N4        &kp N5                                 &kp N6          &kp N7            &kp N8             &kp N9         &kp N0    &kp MINUS
&kp TAB     &kp Q   &kp W       &kp F         &kp P         &kp G                                  &kp J           &kp L             &kp U              &kp Y          &kp SEMI  &kp BSLH
&kp LCTRL   &kp A   &kp R       &kp S         &kp T         &kp D                                  &kp H           &kp N             &kp E              &kp I          &kp O     &kp APOS
&kp ESCAPE  &kp Z   &kp X       &kp C         &kp V         &kp B      &kp K        &kp M          &kp K           &kp M             &kp COMMA          &kp DOT        &kp FSLH  &kp EQUAL
                    &kp DELETE  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE  &kp ENTER    &kp BACKSPACE  &kp LEFT_SHIFT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp RIGHT_ALT
            >;

            sensor-bindings =
                <&inc_dec_gresc 0 0>,
                <&inc_dec_kp LC(PLUS) LC(MINUS)>;
        };

        colemak {
            display-name = "colemak";
            bindings = <
&kp GRAVE   &kp N1  &kp N2           &kp N3        &kp N4           &kp N5                                  &kp N6           &kp N7                       &kp N8                        &kp N9            &kp N0         &kp MINUS
&kp TAB     &kp Q   &kp W            &kp F         &kp P            &kp G                                   &kp J            &kp L                        &kp U                         &kp Y             &kp SEMICOLON  &kp BACKSLASH
&kp LCTRL   &kp A   &hml LEFT_WIN R  &hml LCTRL S  &hml LEFT_ALT T  &kp D                                   &kp H            &hmr LEFT_ALT N              &hmr RCTRL E                  &hmr RIGHT_GUI I  &kp O          &kp SQT
&kp ESCAPE  &kp Z   &kp X            &kp C         &kp V            &kp B      &kp C_MUTE    &bt BT_CLR     &kp K            &kp M                        &kp COMMA                     &kp DOT           &kp FSLH       &kp EQUAL
                    &kp DELETE       &kp LEFT_GUI  &kp LEFT_ALT     &kp SPACE  &kp RET       &kp BACKSPACE  &kp RIGHT_SHIFT  &hmr RIGHT_ALT LEFT_BRACKET  &hmr RIGHT_BRACKET RIGHT_WIN  &kp SYSREQ
            >;

            sensor-bindings =
                <&inc_dec_gresc 0 0>,
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        function {
            bindings = <
&kp F22  &kp F23  &kp F24        &kp F10        &kp F11       &kp F12                                   &kp KP_NUMLOCK   &kp KP_DIVIDE            &kp KP_MULTIPLY           &kp KP_MINUS  &trans  &trans
&kp F19  &kp F20  &kp F21        &kp F7         &kp F8        &kp F9                                    &kp KP_N7        &kp KP_NUMBER_8          &kp KP_NUMBER_9           &kp KP_PLUS   &trans  &trans
&kp F16  &kp F17  &hml LGUI F18  &hml LCTRL F4  &kp F5        &kp F6                                    &kp KP_NUMBER_4  &kp KP_NUMBER_5          &kp KP_NUMBER_6           &kp KP_ENTER  &trans  &trans
&kp F13  &kp F14  &kp F15        &kp F1         &kp F2        &kp F3        &to 3           &bt BT_CLR  &kp KP_NUMBER_1  &kp KP_NUMBER_2          &kp KP_N3                 &kp KP_EQUAL  &trans  &trans
                  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp TAB     &kp KP_NUMBER_0  &kp KP_LEFT_PARENTHESIS  &kp KP_RIGHT_PARENTHESIS  &kp KP_DOT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        qwerty {
            display-name = "qwerty";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | DEL   |
            // | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // |  CTRL |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE   &kp N1  &kp N2           &kp N3        &kp N4           &kp N5                               &kp N6           &kp N7            &kp N8             &kp N9            &kp N0    &kp MINUS
&kp TAB     &kp Q   &kp W            &kp E         &kp R            &kp T                                &kp Y            &kp U             &kp I              &kp O             &kp P     &kp BACKSLASH
&kp LCTRL   &kp A   &hml LEFT_WIN S  &hml LCTRL D  &hml LEFT_ALT F  &kp G                                &kp H            &hmr RIGHT_ALT J  &hmr RCTRL K       &hmr RIGHT_GUI L  &kp SEMI  &kp SQT
&kp ESCAPE  &kp Z   &kp X            &kp C         &kp V            &kp B      &to 3      &bt BT_CLR     &kp N            &kp M             &kp COMMA          &kp DOT           &kp FSLH  &kp EQUAL
                    &kp DELETE       &kp LEFT_GUI  &kp LEFT_ALT     &kp SPACE  &kp RET    &kp BACKSPACE  &kp RIGHT_SHIFT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp C_MENU
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };
    };
};
